---
const { post } = Astro.props;
---

<article class="technical-card bg-surface-container-lowest border p-[var(--spacing-gutter)]" style="border-color: var(--color-outline-variant);">
  <div class="flex flex-col md:flex-row justify-between items-start mb-[var(--spacing-base)]">
    <span class="card-date font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] mb-[var(--spacing-base)] md:mb-0 text-on-surface-variant">
      {post.date} • {post.readTime} MIN READ
    </span>
  </div>

  <a href={`/blog/${post.slug}`}>
    <h2 class="card-title mb-4 transition-colors cursor-pointer" style={`font-family: var(--font-headline-lg); font-size: var(--font-size-headline-lg); line-height: var(--font-size-headline-lg--line-height); font-weight: var(--font-size-headline-lg--font-weight);`}>
      {post.title}
    </h2>
  </a>

  <p class="card-excerpt mb-6 leading-relaxed text-on-surface-variant">
    {post.excerpt}
  </p>

  <div class="flex flex-wrap gap-2 mb-8">
    {post.tags.map((tag: string) => (
      <span class="card-tag font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] border px-3 py-1 border-outline-variant">
        {tag}
      </span>
    ))}
  </div>

  <a
    class="card-read-link inline-flex items-center gap-2 font-bold hover:gap-4 transition-all text-primary"
    href={`/blog/${post.slug}`}
  >
    READ FULL ARTICLE
    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
  </a>
</article>

<style>
  article.technical-card {
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  article.technical-card:hover {
    background-color: #131b2e !important;
    border-color: #acedff !important;
  }

  article.technical-card:hover .card-date {
    color: rgba(255, 255, 255, 0.9);
  }

  article.technical-card:hover .card-title {
    color: #acedff;
  }

  article.technical-card:hover .card-excerpt {
    color: rgba(255, 255, 255, 0.8);
  }

  article.technical-card:hover .card-tag {
    border-color: white;
    color: white;
  }

  article.technical-card:hover .card-read-link {
    color: #acedff;
  }
</style>
