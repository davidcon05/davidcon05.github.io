---
const { post } = Astro.props;
---

<a
  href={`/blog/${post.slug}`}
  class="post-row group flex flex-col md:flex-row md:items-center gap-1 md:gap-4 py-4 border-b border-outline-variant transition-colors"
>
  <span class="post-row-meta shrink-0 md:w-40 flex flex-col font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-on-surface-variant transition-colors">
    <span>{post.date}</span>
    <span>{post.readTime} MIN</span>
  </span>
  <h3 class="post-row-title font-[var(--font-body-lg)] text-[var(--font-size-body-lg)] font-medium transition-colors">
    {post.title}
  </h3>
</a>

<style>
  .post-row:hover {
    background-color: #131b2e !important;
  }

  .post-row:hover .post-row-meta {
    color: rgba(255, 255, 255, 0.9);
  }

  .post-row:hover .post-row-title {
    color: #acedff;
  }
</style>
