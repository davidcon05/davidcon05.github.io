---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNavBar from '../components/TopNavBar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Projects | David Contreras" description="Production apps and works in progress — built to solve real problems.">
  <TopNavBar currentPath="/projects" />

  <main class="pt-32 pb-[var(--spacing-section-gap)] max-w-7xl mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]">

    <!-- Hero -->
    <section class="mb-[var(--spacing-section-gap)]">
      <div class="max-w-2xl">
        <div class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary mb-4" style="letter-spacing: var(--font-size-label-mono--letter-spacing);">
          PERSONAL_PROJECTS
        </div>
        <h1 class="text-primary mb-6" style="font-family: var(--font-headline-xl); font-size: var(--font-size-headline-xl); line-height: var(--font-size-headline-xl--line-height); font-weight: var(--font-size-headline-xl--font-weight); letter-spacing: var(--font-size-headline-xl--letter-spacing);">
          Built to Solve Real Problems.
        </h1>
        <p class="font-[var(--font-body-lg)] text-[var(--font-size-body-lg)] text-on-surface-variant" style="line-height: var(--font-size-body-lg--line-height);">
          Every project here started as a personal problem. A workflow my wife had to do across five devices that should have been one. A tool that didn't exist for the way she actually works. If the problem was real enough, I built the solution.
        </p>
      </div>
    </section>

    <!-- Featured: EcoJournal -->
    <section class="mb-[var(--spacing-section-gap)]">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-primary" style="font-family: var(--font-label-mono); font-size: var(--font-size-label-mono); letter-spacing: 0.15em;">SHIPPED</h2>
        <div class="h-px bg-outline-variant flex-grow"></div>
      </div>

      <article class="border border-outline-variant bg-surface-container-lowest hover:border-secondary transition-colors group">
        <div class="grid grid-cols-1 md:grid-cols-2">

          <!-- Left: Info -->
          <div class="p-8 md:p-12 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-6">
                <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary uppercase">iOS Application</span>
                <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] px-2 py-0.5 border" style="border-color: #4cd7f6; color: #4cd7f6;">IN TESTFLIGHT</span>
              </div>
              <h2 class="mb-4" style="font-family: var(--font-headline-lg); font-size: var(--font-size-headline-lg); line-height: var(--font-size-headline-lg--line-height); font-weight: var(--font-size-headline-lg--font-weight);">
                EcoJournal
              </h2>
              <p class="font-[var(--font-body-md)] text-[var(--font-size-body-md)] text-on-surface-variant mb-8" style="line-height: var(--font-size-body-md--line-height);">
                My wife is an environmental scientist. I've watched her do field work with a GPS unit, a voice recorder, a camera, and a weather app all open at once — then spend hours consolidating it all before the real analysis could start. EcoJournal replaces every one of those tools with a single app built around her workflow.
              </p>

              <div class="grid grid-cols-2 gap-4 mb-8">
                <div class="bg-surface-container p-4">
                  <p class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary mb-1">TEST COVERAGE</p>
                  <p class="font-bold text-primary text-xl">85%+</p>
                </div>
                <div class="bg-surface-container p-4">
                  <p class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary mb-1">AUTOMATED TESTS</p>
                  <p class="font-bold text-primary text-xl">105</p>
                </div>
                <div class="bg-surface-container p-4">
                  <p class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary mb-1">PROD CRASHES</p>
                  <p class="font-bold text-primary text-xl">0</p>
                </div>
                <div class="bg-surface-container p-4">
                  <p class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary mb-1">BUILD TIME</p>
                  <p class="font-bold text-primary text-xl">4 Weekends</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mb-8">
                <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">SWIFTUI</span>
                <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">SWIFTDATA</span>
                <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">XCUITEST</span>
                <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">XCODE CLOUD</span>
                <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">OFFLINE-FIRST</span>
              </div>
            </div>

            <a
              href="/projects/ecojournal"
              class="inline-flex items-center gap-2 font-bold font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-primary group-hover:text-secondary transition-colors"
            >
              VIEW PROJECT
              <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
            </a>
          </div>

          <!-- Right: Screenshot placeholder -->
          <div class="border-l border-outline-variant bg-surface-container-low flex flex-col items-center justify-center gap-4 p-12 min-h-[400px]">
            <span class="material-symbols-outlined text-outline-variant" style="font-size: 64px;">smartphone</span>
            <div class="text-center">
              <p class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary mb-1">📸 DAVE</p>
              <p class="font-[var(--font-body-md)] text-[var(--font-size-body-md)] text-on-surface-variant">Drop a TestFlight screenshot here. Pick the map view — it's the most impressive one.</p>
            </div>
          </div>

        </div>
      </article>
    </section>

    <!-- In the Lab -->
    <section>
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-primary" style="font-family: var(--font-label-mono); font-size: var(--font-size-label-mono); letter-spacing: 0.15em;">IN THE LAB</h2>
        <div class="h-px bg-outline-variant flex-grow"></div>
        <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-on-surface-variant">Work in progress — building in public</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--spacing-gutter)]">

        <!-- BookSquad -->
        <article class="border border-outline-variant bg-surface-container-lowest hover:border-secondary transition-colors p-8 flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary uppercase">KMP · iOS + Android</span>
            <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] px-2 py-0.5 border border-outline-variant text-on-surface-variant">SCAFFOLDING</span>
          </div>
          <h3 class="mb-4" style="font-family: var(--font-headline-md); font-size: var(--font-size-headline-md); line-height: var(--font-size-headline-md--line-height); font-weight: var(--font-size-headline-md--font-weight);">
            BookSquad
          </h3>
          <p class="font-[var(--font-body-md)] text-[var(--font-size-body-md)] text-on-surface-variant mb-6 flex-grow" style="line-height: var(--font-size-body-md--line-height);">
            My wife's collection is so vast I couldn't buy her books without getting it wrong — so I defaulted to gift cards. That felt like giving up. BookSquad started as a fix and grew into a full digital book club: she and her friends rate, review, and comment together, while the Curator AI recommends what to read next based on the tropes in her own library.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">KOTLIN MULTIPLATFORM</span>
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">COMPOSE</span>
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">ON-DEVICE AI</span>
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">SQLDELIGHT</span>
          </div>
          <a
            href="/projects/booksquad"
            class="inline-flex items-center gap-2 font-bold font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-primary hover:text-secondary transition-colors"
          >
            VIEW PROJECT
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
          </a>
        </article>

        <!-- A1Fit -->
        <article class="border border-outline-variant bg-surface-container-lowest hover:border-secondary transition-colors p-8 flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-secondary uppercase">Android</span>
            <span class="font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] px-2 py-0.5 border border-outline-variant text-on-surface-variant">ON PAUSE</span>
          </div>
          <h3 class="mb-4" style="font-family: var(--font-headline-md); font-size: var(--font-size-headline-md); line-height: var(--font-size-headline-md--line-height); font-weight: var(--font-size-headline-md--font-weight);">
            A1Fit
          </h3>
          <p class="font-[var(--font-body-md)] text-[var(--font-size-body-md)] text-on-surface-variant mb-6 flex-grow" style="line-height: var(--font-size-body-md--line-height);">
            I found out I had diabetes during a routine physical. As a gamer, I turned managing it into a quest — 10,000 steps a day, post-meal walks, blood sugar targets, A1C under 6. Six months later: A1C at 6.1, down 20 lbs. Built the Android app to track all of it.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">ANDROID</span>
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">KOTLIN</span>
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">HEALTH TRACKING</span>
            <span class="font-[var(--font-label-mono)] text-[11px] bg-surface-container px-3 py-1">GAMIFICATION</span>
          </div>
          <a
            href="/projects/a1fit"
            class="inline-flex items-center gap-2 font-bold font-[var(--font-label-mono)] text-[var(--font-size-label-mono)] text-primary hover:text-secondary transition-colors"
          >
            VIEW PROJECT
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
          </a>
        </article>

      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
