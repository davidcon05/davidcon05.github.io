<script>
  // Status rotation
  const statusEl = document.querySelector('.bg-primary-container.text-on-primary-container');
  const statuses = ['SYSTEM_STATUS: READY', 'ENGINE: STABLE', 'LATENCY: 12ms', 'UPTIME: 99.9%'];
  let currentIndex = 0;

  if (statusEl) {
    setInterval(() => {
      currentIndex = (currentIndex + 1) % statuses.length;
      statusEl.textContent = statuses[currentIndex];
    }, 3000);
  }

  // Trophy badge hover effects
  document.querySelectorAll('.skill-badge').forEach(badge => {
    badge.addEventListener('mouseenter', () => {
      const icon = badge.querySelector('.material-symbols-outlined');
      if (icon) {
        icon.style.fontVariationSettings = "'FILL' 1";
      }
    });
    badge.addEventListener('mouseleave', () => {
      const icon = badge.querySelector('.material-symbols-outlined');
      if (icon && !badge.classList.contains('border-tertiary-fixed')) {
        icon.style.fontVariationSettings = "'FILL' 0";
      }
    });
  });
</script>
